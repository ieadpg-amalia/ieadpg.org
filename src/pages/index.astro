---
import { getCollection } from 'astro:content';

const allCultos = await getCollection('cultos');
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="color-scheme" content="dark" />

    <title>IEADPG Jardim Amália · Igreja Assembleia de Deus, Ponta Grossa</title>
    <meta
      name="description"
      content="Assembleia de Deus no Jardim Amália, Ponta Grossa: cultos domingo 19h e quarta 20h. Conheça a família e o projeto da nova casa."
    />
    <link rel="canonical" href="https://ieadpg.org/" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="IEADPG Jardim Amália" />
    <meta property="og:title" content="IEADPG Jardim Amália · Igreja Assembleia de Deus, Ponta Grossa" />
    <meta
      property="og:description"
      content="Assembleia de Deus no Jardim Amália, Ponta Grossa: cultos domingo 19h e quarta 20h. Conheça a família e o projeto da nova casa."
    />
    <meta property="og:url" content="https://ieadpg.org/" />
    <meta property="og:image" content="https://media.ieadpg.org/opengraph-image.jpg" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Schema.org Church / Organization -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://ieadpg.org/#website",
            "name": "IEADPG Jardim Amália",
            "url": "https://ieadpg.org",
            "inLanguage": "pt-BR"
          },
          {
            "@type": ["Church", "Organization"],
            "@id": "https://ieadpg.org/#igreja",
            "name": "IEADPG Jardim Amália",
            "alternateName": "Igreja Evangélica Assembleia de Deus — Jardim Amália",
            "url": "https://ieadpg.org",
            "telephone": "+55 42 99938-4069",
            "email": "contato@ieadpg.org",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Rua Paulina Oliveira Gomes, 1071",
              "addressLocality": "Ponta Grossa",
              "addressRegion": "PR",
              "addressCountry": "BR"
            },
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": -25.1368187,
              "longitude": -50.137646
            }
          }
        ]
      }
    </script>
  </head>
  <body class="bg-black text-[#f4efe6] antialiased">
    <main class="min-h-screen flex flex-col justify-between p-6 max-w-4xl mx-auto">
      <header class="py-8">
        <p class="text-xs uppercase tracking-widest text-amber-500 font-semibold">Igreja Evangélica Assembleia de Deus</p>
        <h1 class="text-4xl md:text-6xl font-serif mt-2">IEADPG · Jardim Amália</h1>
      </header>

      <section class="space-y-6 my-auto">
        <p class="text-lg md:text-xl leading-relaxed text-neutral-300">
          Somos uma família vivendo a unidade em amor — e estamos construindo a nossa nova casa no Jardim Amália.
          Aqui você é acolhido, edificado e preparado para viver o seu propósito em Deus.
        </p>

        <div class="border-l-2 border-amber-500 pl-4 py-2 space-y-1">
          <p><strong>Cultos:</strong> Domingo 19h · Celebração — Quarta 20h · Alinhamento</p>
          <p><strong>Endereço:</strong> Rua Paulina Oliveira Gomes, 1071 — Jardim Amália, Ponta Grossa/PR</p>
        </div>

        <p class="italic text-neutral-400">
          “Acima de tudo, revistam-se do amor” — Colossenses 3:14
        </p>

        <div class="flex flex-wrap gap-4 pt-4">
          <a
            href="https://wa.me/5542999384069"
            class="px-6 py-3 rounded-full bg-amber-600 hover:bg-amber-500 text-white font-medium transition shadow-lg"
          >
            Falar no WhatsApp
          </a>
          <a
            href="https://maps.app.goo.gl/nKgD83xmGetsyDzKA"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-full border border-neutral-700 hover:border-neutral-500 text-neutral-300 transition"
          >
            Como chegar
          </a>
        </div>
      </section>

      <footer class="py-8 border-t border-neutral-900 text-xs text-neutral-500 flex justify-between items-center">
        <p>&copy; {new Date().getFullYear()} IEADPG Jardim Amália. Todos os direitos reservados.</p>
        <a href="/admin" class="hover:text-neutral-400">Área Administrativa</a>
      </footer>
    </main>
  </body>
</html>
