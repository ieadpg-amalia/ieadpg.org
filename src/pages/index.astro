---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="container">
    <header class="hero">
      <p class="eyebrow">Igreja Evangélica Assembleia de Deus</p>
      <h1>IEADPG · Jardim Amália</h1>
      <p class="description">
        Somos uma família vivendo a unidade em amor — e estamos construindo a nossa nova casa no Jardim Amália.
        O prédio que aparece nos vídeos deste site é o projeto: o nosso sonho tomando forma. Aqui você é acolhido,
        edificado e preparado para viver o seu propósito em Deus.
      </p>
    </header>

    <section class="info-section">
      <div class="card">
        <h3>Cultos</h3>
        <p><strong>Domingo 19h:</strong> Celebração</p>
        <p><strong>Quarta 20h:</strong> Alinhamento</p>
      </div>

      <div class="card">
        <h3>Endereço</h3>
        <p>Rua Paulina Oliveira Gomes, 1071 — Jardim Amália, Ponta Grossa/PR</p>
        <a class="link" href="https://maps.app.goo.gl/nKgD83xmGetsyDzKA" target="_blank" rel="noopener noreferrer">Como chegar no Google Maps</a>
      </div>

      <div class="card">
        <h3>Contato</h3>
        <p>Fale diretamente com nossa liderança pelo WhatsApp ou acesse o Portal do Membro.</p>
        <div class="actions">
          <a class="btn primary" href="https://wa.me/5542999384069" target="_blank" rel="noopener noreferrer">Falar no WhatsApp</a>
          <a class="btn secondary" href="https://app.ieadpg.org" target="_blank" rel="noopener noreferrer">Portal do Membro</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 64px 24px;
  }
  .hero {
    margin-bottom: 48px;
  }
  .eyebrow {
    color: #c59b27;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 8px;
  }
  h1 {
    font-family: var(--font-cormorant);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.1;
    margin: 0 0 16px;
    color: #f4efe6;
  }
  .description {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #c9c3b8;
  }
  .info-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
    margin-top: 32px;
  }
  .card {
    background: #141414;
    border: 1px solid #282828;
    border-radius: 12px;
    padding: 24px;
  }
  .card h3 {
    margin-top: 0;
    margin-bottom: 12px;
    color: #c59b27;
  }
  .link {
    color: #e5b945;
    text-decoration: underline;
    display: inline-block;
    margin-top: 8px;
  }
  .actions {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 6px;
    font-weight: 500;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .btn.primary {
    background: #c59b27;
    color: #0b0b0b;
  }
  .btn.secondary {
    background: #222;
    color: #f4efe6;
    border: 1px solid #444;
  }
</style>
