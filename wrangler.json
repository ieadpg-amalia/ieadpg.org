{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ieadpg-amalia",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "SITE_URL": "https://ieadpg.org",
    "API_URL": "https://app.ieadpg.org",
    "MEDIA_URL": "https://media.ieadpg.org"
  },
  "observability": {
    "enabled": true
  }
}
